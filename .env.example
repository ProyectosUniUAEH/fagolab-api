# PostgreSQL (local). En Kaanbal llegan FAGOLAB_BD_HOST/PORT/USER/PASSWORD/DATABASE.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fago_bd_postgres
POSTGRES_USER=devadmin
POSTGRES_PASSWORD=CAMBIAR_ESTA_CLAVE

# Entorno y URLs permitidas (separadas por coma)
APP_ENV=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Autenticación
# En producción genera al menos 64 bytes aleatorios y guárdalos fuera de Git.
AUTH_JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_LARGO
AUTH_JWT_ISSUER=fagolab
AUTH_ACCESS_MINUTES=15
AUTH_REFRESH_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
# Actívalo solo detrás de un proxy propio que reemplace X-Forwarded-For.
AUTH_TRUST_PROXY_HEADERS=false

# Archivos subidos
MEDIA_DIR=./_media

# Agente IA (la llave de proveedor se guarda cifrada en PostgreSQL)
# Fuera de local, AGENT_ENCRYPTION_KEY es obligatoria y debe venir de un Secret.
AGENT_ENCRYPTION_KEY=
AGENT_SHELL_ENABLED=false
AGENT_SHELL_ALLOW_REMOTE=false
AGENT_SHELL_WORKDIR=.
AGENT_SHELL_TIMEOUT_S=30
AGENT_HTTP_TIMEOUT_S=20
